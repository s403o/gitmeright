root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Shell and bats use tabs, matching the existing style.
[*.{sh,bash,bats}]
indent_style = tab

[bin/gitmeright]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
